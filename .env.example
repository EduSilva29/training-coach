# Garmin Connect Credentials
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_garmin_password

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=running_coach

# Google Gemini Free Tier API Key (Get free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-4-hydrogen
# Optional: use a fast lightweight model for the background scribe (defaults to GEMINI_MODEL)
# GEMINI_SCRIBE_MODEL=gemini-3.8-flash
